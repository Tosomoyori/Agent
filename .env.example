# 复制为 .env 后填入真实值。.env 已被 .gitignore 排除，不要提交。

# ---- LLM ----
# DeepSeek 官方 API Key（https://platform.deepseek.com/api_keys）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 可选：覆盖默认模型。账号下当前可用：deepseek-flash / deepseek-v4-pro
# 注意：deepseek-chat 与 deepseek-reasoner 已于 2026 年下线，不要再使用。
LLM_MODEL=deepseek-flash

# 可选：切换到其他 OpenAI 兼容端点（如 Qwen / Kimi / GLM）
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=
